DJANGO_SECRET_KEY=change-this-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=encodestudio
DB_USER=encodestudio_app
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Email — console backend prints emails to the runserver log instead of
# actually sending them. Switch to smtp and fill in real credentials once
# you have them (see backend/README.md for provider options).
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

DEFAULT_FROM_EMAIL=Encode Studio <no-reply@encodestudio.in>
ADMIN_EMAIL=shivam@encodestudio.in
ADMIN_EMAIL_CC=encodestudio.in@gmail.com
FRONTEND_ADMIN_URL=http://localhost:8000/admin/contact/lead/

# Copy to backend/.env (or set these as environment variables on your host).

NODE_ENV=development
PORT=8000

# Signs lead-portal login tokens. Use a long random string in production.
# (Falls back to DJANGO_SECRET_KEY if that is still set.)
JWT_SECRET=change-this-in-production

# MySQL — same variables (and same database) the Django backend used.
DB_NAME=encodestudio
DB_USER=encodestudio_app
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
# Set to True if your MySQL host requires TLS (most managed/remote MySQL does).
DB_SSL=False

# Only needed if the React app is served from a different origin than the API.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Number of reverse proxies in front of Node, for correct client IPs in rate limiting.
TRUST_PROXY=1
CONTACT_RATE_LIMIT_PER_HOUR=20

# Email — leave EMAIL_HOST empty (or EMAIL_BACKEND=console) to print emails to the
# server log instead of sending them.
EMAIL_BACKEND=console
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False

DEFAULT_FROM_EMAIL=Encode Studio <no-reply@encodestudio.in>
ADMIN_EMAIL=shivam@encodestudio.in
ADMIN_EMAIL_CC=encodestudio.in@gmail.com

# Where "Open in Lead Manager" in the new-lead email points.
LEADS_PORTAL_URL=http://localhost:5173/leads

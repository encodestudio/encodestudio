# The Node backend serves this build and the API from the same origin, so the
# defaults ("/api/contact/" and "/api") need no configuration. Only set these
# if the API is ever hosted on a different domain than the site.
# VITE_CONTACT_ENDPOINT=https://api.example.com/api/contact/
# VITE_API_BASE_URL=https://api.example.com/api

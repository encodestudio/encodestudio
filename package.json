{
  "name": "encodestudio",
  "private": true,
  "description": "Encode Studio website — React frontend + API on one Cloudflare Worker (Hono + D1)",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "setup": "npm install && npm install --prefix backend && npm install --prefix frontend",
    "build": "npm run build --prefix frontend",
    "dev": "wrangler dev",
    "dev:frontend": "npm run dev --prefix frontend",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply DB --remote",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "staff": "npm run staff --prefix backend --",
    "export-mysql": "npm run export-mysql --prefix backend --",
    "logs": "wrangler tail"
  },
  "devDependencies": {
    "wrangler": "^4.149.0"
  }
}
